# Copy to .env in the repo root. server/ loads this file via dotenv.

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fika
DB_PASSWORD=changeme
DB_NAME=fika_friday

# --- Server ---
PORT=3001
NODE_ENV=development
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
# OAuth 2.0 Client ID from Google Cloud Console (Web application type).
# Must match VITE_GOOGLE_CLIENT_ID used by the web app.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Only accounts on this Google Workspace domain are allowed to log in.
GOOGLE_ALLOWED_DOMAIN=telavox.com
# Long random string used to sign session JWTs. `openssl rand -hex 32`
JWT_SECRET=changeme-generate-a-real-secret
# Comma-separated emails that are always granted the admin role on login.
ADMIN_EMAILS=philip.stenberg@telavox.com

# --- Fika schedule ---
# Guessing opens Friday 08:00 Europe/Stockholm and stays open this many minutes.
FIKA_GUESS_WINDOW_MINUTES=120

# --- n8n AI grading (optional) ---
# When set, revealing an event's answer in /admin automatically POSTs the
# event + all guesses to this n8n webhook URL for AI grading. Leave unset to
# disable — grading stays fully manual.
N8N_GRADE_WEBHOOK_URL=
# Shared secret n8n must send back as the `x-webhook-secret` header when it
# POSTs graded results to POST /api/webhooks/n8n/grade. Required if
# N8N_GRADE_WEBHOOK_URL is set. `openssl rand -hex 32`
N8N_CALLBACK_SECRET=changeme-generate-a-real-secret
